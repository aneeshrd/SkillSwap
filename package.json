{
  "name": "skillswap",
  "version": "0.1.0",
  "private": true,
  "description": "SkillSwap \u2014 a student skill-exchange platform. Your skills become your currency.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -f data/skillswap.db && tsx scripts/seed.ts",
    "sweep": "tsx scripts/sweep.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.2.0",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
