# ---------------------------------------------------------------------------
# SkillSwap environment
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Secret used to sign session cookies (HMAC-SHA256).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-32-byte-random-hex-string

# Where the SQLite file lives, relative to the project root.
DATABASE_PATH=data/skillswap.db

# Comma-separated list of email domains allowed to register.
# Students must sign up with an address at one of these domains.
ALLOWED_EMAIL_DOMAINS=students.northfield.edu,northfield.edu,example.edu

# Email transport. "console" prints verification codes to the server log,
# which is what you want in development. "smtp" is a stub to wire up for a pilot.
EMAIL_TRANSPORT=console

# Emails listed here get access to /admin (moderation + verification queue).
ADMIN_EMAILS=dean.okafor@northfield.edu

# Set to "1" to tell the verify page that codes are being printed to the server
# log rather than emailed. Codes are stored hashed, so no page can ever show
# you the code itself. Leave unset in any real deployment.
DEV_CODE_HINT=1
