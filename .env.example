# ---------------------------------------------------------------------------
# SkillSwap environment
# Copy to `.env.local` for local development. Never commit `.env.local`.
# On Fly.io these go in `fly secrets set` (secrets) or fly.toml (non-secrets).
# ---------------------------------------------------------------------------

# --- required ---------------------------------------------------------------

# Signs session cookies and video-call tickets. Changing it logs everyone out.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-32-byte-random-hex-string

# Where the SQLite file lives. Locally a relative path; in the container this
# must point at the mounted volume (/data/skillswap.db).
DATABASE_PATH=data/skillswap.db

# Who may register. Comma separated; subdomains of a listed domain also pass.
# Leave empty to accept any address (not advisable in a real deployment).
ALLOWED_EMAIL_DOMAINS=students.northfield.edu,northfield.edu,example.edu

# Who can open /admin — the moderation queue. Comma separated.
ADMIN_EMAILS=dean.okafor@northfield.edu

# --- email ------------------------------------------------------------------
# Without working email nobody can verify an account, so nobody can sign up.
#
#   console  print codes to the server log (local development)
#   resend   send for real through https://resend.com
#
# Unset falls back to "resend" when RESEND_API_KEY exists, otherwise "console".
EMAIL_TRANSPORT=console

# From https://resend.com/api-keys (free tier: 3,000 emails/month).
RESEND_API_KEY=

# Must be a domain you verified with Resend. Their shared sender
# (onboarding@resend.dev) only delivers to your own account address, which is
# fine for a smoke test and useless for real students.
EMAIL_FROM=SkillSwap <noreply@yourdomain.edu>

# --- video calls ------------------------------------------------------------
# Calls are peer-to-peer WebRTC. Google's public STUN servers are built in and
# handle most networks. A TURN relay handles the rest — and university wifi is
# exactly the kind of network that needs one. Without it, some calls will
# simply fail to connect.
#
# Free TURN credentials: https://www.metered.ca/tools/openrelay/
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
